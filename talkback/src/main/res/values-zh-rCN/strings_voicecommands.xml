  <string name="voice_commands_call_choose_item">%1$d，%2$s。</string>
  <!-- Spoken before Android asks for the phone and contacts permissions that calling by voice needs. [CHAR_LIMIT=NONE] -->
  <string name="voice_commands_call_permission_needed">要使用语音拨打和接听电话，Backtalk 需获取权限。请在后续界面中授权，然后再次说出指令。</string>
  <!-- Spoken when the voice command answers a ringing call. [CHAR_LIMIT=NONE] -->
  <string name="voice_commands_call_answering">接听来电</string>
  <!-- Spoken when the voice command declines a ringing call. [CHAR_LIMIT=NONE] -->
