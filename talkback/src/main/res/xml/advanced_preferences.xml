<?xml version="1.0" encoding="UTF-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="@string/pref_category_controls_key"
      android:title="@string/title_pref_category_controls" >
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_category_latency_reduction_shortcut_key"
        android:title="@string/title_pref_latency_reduction"
        android:summary="@string/talkback_latency_reduction_summary"
        android:fragment="com.google.android.accessibility.talkback.preference.base.TalkBackLatencyReductionPreferenceFragment" >
    </com.google.android.accessibility.material.preference.AccessibilitySuitePreference>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
        android:defaultValue="@string/pref_lift_to_activate_default"
        android:dialogTitle="@string/title_pref_lift_to_activate"
        android:entries="@array/pref_lift_to_activate_entries"
        android:entryValues="@array/pref_lift_to_activate_values"
        android:key="@string/pref_lift_to_activate_key"
        android:summary="%s"
        android:title="@string/title_pref_lift_to_activate" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_wrap_around_default"
        android:key="@string/pref_wrap_around_key"
        android:summary="@string/summary_pref_wrap_around"
        android:title="@string/title_pref_wrap_around" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_proximity_default"
        android:key="@string/pref_proximity_key"
        android:title="@string/title_pref_cover_proximity_sensor" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="@string/pref_speakerphone_away_from_ear_key"
        android:title="@string/title_pref_speakerphone_away_from_ear"
        android:summary="@string/summary_pref_speakerphone_away_from_ear" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="@string/pref_speech_control_key"
        android:title="@string/title_pref_speech_control"
        android:summary="@string/summary_pref_speech_control" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_manage_labels_key"
        android:title="@string/title_pref_manage_labels" >
      <intent
          android:targetPackage="@string/app_id"
          android:targetClass="com.google.android.accessibility.talkback.labeling.LabelManagerSummaryActivity" />
    </com.google.android.accessibility.material.preference.AccessibilitySuitePreference>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_single_tap_default"
        android:key="@string/pref_single_tap_key"
        android:summary="@string/summary_pref_single_tap"
        android:title="@string/title_pref_single_tap" />
    <!-- Description order -->
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
        android:defaultValue="@string/pref_node_desc_order_default"
        android:dialogTitle="@string/pref_node_desc_order_title"
        android:entries="@array/pref_node_desc_order_entries"
        android:entryValues="@array/pref_node_desc_order_values"
        android:key="@string/pref_node_desc_order_key"
        android:summary="%s"
        android:title="@string/pref_node_desc_order_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
        android:defaultValue="@string/pref_time_feedback_format_default"
        android:dialogTitle="@string/pref_time_feedback_format_title"
        android:entries="@array/pref_time_feedback_format_entries"
        android:entryValues="@array/pref_time_feedback_format_values"
        android:key="@string/pref_time_feedback_format_key"
        android:summary="%s"
        android:title="@string/pref_time_feedback_format_title"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
        android:defaultValue="@string/pref_resume_backtalk_default"
        android:dialogTitle="@string/title_pref_resume_backtalk"
        android:entries="@array/pref_resume_backtalk_entries"
        android:entryValues="@array/pref_resume_backtalk_values"
        android:key="@string/pref_resume_backtalk_key"
        android:summary="%s"
        android:title="@string/title_pref_resume_backtalk"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_reduce_window_delay_default"
        android:key="@string/pref_reduce_window_delay_key"
        android:summary="@string/pref_reduce_window_delay_summary"
        android:title="@string/pref_reduce_window_delay_title"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_auto_enter_table_navigation_default"
        android:key="@string/pref_auto_enter_table_navigation_key"
        android:title="@string/pref_auto_enter_table_navigation_title"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_smart_browse_mode_default"
        android:key="@string/pref_smart_browse_mode_key"
        android:title="@string/title_smart_browse_mode"
        android:summary="@string/summary_smart_browse_mode"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_show_exit_watermark_default"
        android:key="@string/pref_show_exit_watermark_key"
        android:summary="@string/summary_pref_show_exit_watermark"
        android:title="@string/title_pref_show_exit_watermark"/>
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="@string/pref_category_others_key">
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_play_store_key"
        android:title="@string/title_pref_play_store" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.DeveloperPrefFragment"
        android:key="@string/pref_category_developer_key"
        android:title="@string/title_pref_category_developer_settings"
        app:allowDividerAbove="true"/>
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
</PreferenceScreen>
