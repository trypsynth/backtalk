    <!-- Label of the quick settings tile that pauses and resumes direct touch. [CHAR LIMIT=20] -->
    <string name="direct_touch_tile_label">Direct touch</string>

    <!-- Title of the direct touch settings screen. [CHAR LIMIT=40] -->
    <string name="title_pref_direct_touch">Toque directo</string>
    <!-- Direct touch settings: master switch title. [CHAR LIMIT=40] -->
    <string name="pref_direct_touch_master">Toque directo</string>
