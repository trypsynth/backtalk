<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Name of the action that pauses Backtalk, in the Backtalk menu, the gesture action list and the menu settings. [CHAR LIMIT=40] -->
    <string name="title_pause_backtalk"> Suspender Backtalk</string>
    <!-- Summary of the Backtalk menu setting that shows the Pause Backtalk item. [CHAR LIMIT=NONE] -->
    <string name="summary_pause_backtalk">Detener la voz, los sonidos y la exploración táctil hasta que reanudes Backtalk.</string>
    <!-- Keyboard shortcut that pauses Backtalk, or resumes it when it is paused. [CHAR LIMIT=40] -->
    <string name="keycombo_menu_global_pause_backtalk">Ssuspender o reanudar Backtalk</string>

    <!-- Spoken when Backtalk pauses. [CHAR LIMIT=NONE] -->
    <string name="backtalk_paused">Backtalk suspendido</string>
    <!-- Spoken when Backtalk resumes after a pause. [CHAR LIMIT=NONE] -->
    <string name="backtalk_resumed">Backtalk reanudado</string>

    <!-- Title of the notification shown while Backtalk is paused. [CHAR LIMIT=NONE] -->
    <string name="notification_title_backtalk_paused">Backtalk está suspendido</string>
    <!-- Text of the notification shown while Backtalk is paused. Tapping it resumes Backtalk. [CHAR LIMIT=NONE] -->
    <string name="notification_message_backtalk_paused">Toca para reanudar</string>
    <!-- Name of the notification channel for the notification shown while Backtalk is paused, in the app's notification settings. [CHAR LIMIT=40] -->
    <string name="notification_channel_backtalk_paused">Backtalk suspendido</string>

    <!-- Title of the dialog that asks before pausing Backtalk. [CHAR LIMIT=NONE] -->
    <string name="dialog_title_pause_backtalk">¿Pausar Backtalk?</string>
    <!-- Button in the dialog that pauses Backtalk. [CHAR LIMIT=20] -->
    <string name="dialog_button_pause_backtalk">Suspender</string>
    <!-- Message of the dialog that asks before pausing Backtalk. [CHAR LIMIT=NONE] -->
    <string name="dialog_message_pause_backtalk">Mientras Backtalk está suspendido, el teléfono no hablará ni responderá a gestos de exploración táctil, como si no hubiera ningún lector activado.</string>
    <!-- How to resume Backtalk when it resumes at the lock screen. [CHAR LIMIT=NONE] -->
    <string name="message_resume_keyguard">Para reanudar Backtalk, presiona la notificación "Backtalk está suspendido", presiona la tecla de bajar volumen 3 veces rápidamente, o muestra la pantalla de bloqueo del  dispositivo.  </string>
    <!-- How to resume Backtalk when it resumes when the screen turns on. [CHAR LIMIT=NONE] -->
    <string name="message_resume_screen_on">Para reanudar, toca la notificación "Backtalk está suspendido", presiona la tecla de bajar volumen 3 veces rápidamente, o apaga y enciende de nuevo la pantalla.</string>
    <!-- How to resume Backtalk when it only resumes from the notification or a shortcut. [CHAR LIMIT=NONE] -->
    <string name="message_resume_manual">Para reanudar, presiona la notificación "Backtalk está suspendido" o presiona la tecla de bajar volumen 3 veces rápidamente.</string>
    <!-- Added to the pause dialog when a keyboard shortcut is set for pausing and resuming Backtalk. [CHAR LIMIT=NONE] -->
    <string name="message_resume_key_combo">También puedes presionar <xliff:g id="key_combo" example="Alt + P">%1$s</xliff:g>.</string>

    <!-- Title of the setting for when Backtalk resumes after a pause. [CHAR LIMIT=NONE] -->
    <string name="title_pref_resume_backtalk">Reanudar Backtalk</string>
    <!-- Setting value: Backtalk resumes when the lock screen shows. [CHAR LIMIT=NONE] -->
    <string name="value_resume_keyguard">Cuando se muestre la pantalla de bloqueo</string>
    <!-- Setting value: Backtalk resumes when the screen turns on. [CHAR LIMIT=NONE] -->
    <string name="value_resume_screen_on">Cuando la pantalla se encienda</string>
    <!-- Setting value: Backtalk resumes only from the notification or a shortcut. [CHAR LIMIT=NONE] -->
    <string name="value_resume_manual">Solo desde la notificación o un atajo de teclado</string>
</resources>
