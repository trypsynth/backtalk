<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Title of the settings screen and its entry in the main list, for saving and restoring all settings. [CHAR LIMIT=40] -->
    <string name="settings_backup_title">Copia de seguridad</string>
    <!-- Backup and restore: saves all settings to a file. [CHAR LIMIT=40] -->
    <string name="settings_backup_export">Exportar configuración</string>
    <!-- Summary of the export action. [CHAR LIMIT=NONE] -->
    <string name="settings_backup_export_summary">Guarda tus configuraciones en un archivo</string>
    <!-- Backup and restore: loads all settings from a file. [CHAR LIMIT=40] -->
    <string name="settings_backup_import">Importar configuración</string>
    <!-- Summary of the import action. [CHAR LIMIT=NONE] -->
    <string name="settings_backup_import_summary">Reemplaza las configuraciones actuales con las de un archivo que hayas exportado. Opciones como pantallas braille que hayas conectado o tu clave de API de Gemini se quedan como están</string>
    <!-- Toast after the settings were saved to a file. [CHAR LIMIT=40] -->
    <string name="settings_backup_export_done">Configuración exportada</string>
    <!-- Toast when the settings could not be saved to a file. [CHAR LIMIT=60] -->
    <string name="settings_backup_export_failed">Error al exportar configuraciones</string>
    <!-- Toast after the settings were restored from a file. [CHAR LIMIT=40] -->
    <string name="settings_backup_import_done">Configuración importada</string>
    <!-- Dialog message after the settings were restored, when some of them only take effect once Backtalk is turned off and on again. [CHAR LIMIT=NONE] -->
    <string name="settings_backup_import_restart">Algunos de los ajustes que estás importando necesitan que reinicies Backtalk para tomar efecto.</string>
    <!-- Toast when a file could not be read as a settings backup. [CHAR LIMIT=60] -->
    <string name="settings_backup_import_failed">Error al leer ese archivo.</string>
</resources>
