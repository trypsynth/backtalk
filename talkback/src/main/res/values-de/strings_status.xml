<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2" xmlns:tools="http://schemas.android.com/tools">
    <!-- Label for the shortcut that speaks the time, battery, and network state. [CHAR LIMIT=40] -->
    <string name="shortcut_announce_status" tools:ignore="MissingTranslation">Status ansagen</string>

    <!-- Status readout: signal strength of a network. [CHAR LIMIT=NONE] -->
    <string name="template_status_bars" tools:ignore="MissingTranslation"><xliff:g id="level" example="3">%1$d</xliff:g> von <xliff:g id="max_level" example="4">%2$d</xliff:g> Balken</string>
    <!-- Status readout: Wi-Fi is turned off. [CHAR LIMIT=NONE] -->
    <string name="status_wifi_off" tools:ignore="MissingTranslation">WLAN aus</string>
    <!-- Status readout: Wi-Fi is on but not connected to a network. [CHAR LIMIT=NONE] -->
    <string name="status_wifi_not_connected" tools:ignore="MissingTranslation">WLAN nicht verbunden</string>
    <!-- Status readout: connected to Wi-Fi when the network name is not available. [CHAR LIMIT=NONE] -->
    <string name="template_status_wifi" tools:ignore="MissingTranslation">WLAN, <xliff:g id="bars" example="3 of 4 bars">%1$s</xliff:g></string>
    <!-- Status readout: connected to a named Wi-Fi network. [CHAR LIMIT=NONE] -->
    <string name="template_status_wifi_named" tools:ignore="MissingTranslation">WLAN <xliff:g id="network_name" example="Home">%1$s</xliff:g>, <xliff:g id="bars" example="3 of 4 bars">%2$s</xliff:g></string>
    <!-- Status readout: mobile network, with the carrier and network type. [CHAR LIMIT=NONE] -->
    <string name="template_status_mobile" tools:ignore="MissingTranslation"><xliff:g id="network" example="T-Mobile, 5G">%1$s</xliff:g>, <xliff:g id="bars" example="2 of 4 bars">%2$s</xliff:g></string>
    <!-- Status readout: name for the mobile network when the carrier is unknown. [CHAR LIMIT=NONE] -->
    <string name="status_mobile" tools:ignore="MissingTranslation">Mobilfunk</string>
    <!-- Status readout: there is no mobile service. [CHAR LIMIT=NONE] -->
    <string name="status_mobile_no_service" tools:ignore="MissingTranslation">Kein Mobilfunkdienst</string>
    <!-- Status readout: Do Not Disturb is on. [CHAR LIMIT=NONE] -->
    <string name="status_do_not_disturb" tools:ignore="MissingTranslation">Nicht stören</string>
    <!-- Status readout: the ringer is set to vibrate. [CHAR LIMIT=NONE] -->
    <string name="status_ringer_vibrate" tools:ignore="MissingTranslation">Vibration</string>
    <!-- Status readout: the ringer is silent. [CHAR LIMIT=NONE] -->
    <string name="status_ringer_silent" tools:ignore="MissingTranslation">Stumm</string>
    <!-- Status readout: airplane mode is on. [CHAR LIMIT=NONE] -->
    <string name="status_airplane_mode" tools:ignore="MissingTranslation">Flugmodus</string>

    <!-- Title of the settings screen that chooses what the status gesture speaks. [CHAR LIMIT=40] -->
    <string name="title_pref_status_readout" tools:ignore="MissingTranslation">Statusanzeige</string>

    <!-- Status readout settings: title of the time item. [CHAR LIMIT=40] -->
    <string name="status_item_time" tools:ignore="MissingTranslation">Uhrzeit</string>
    <!-- Status readout settings: summary of the time item. [CHAR LIMIT=NONE] -->
    <string name="status_item_time_summary" tools:ignore="MissingTranslation">Die aktuelle Uhrzeit</string>
    <!-- Status readout settings: title of the battery item. [CHAR LIMIT=40] -->
    <string name="status_item_battery" tools:ignore="MissingTranslation">Akku</string>
    <!-- Status readout settings: summary of the battery item. [CHAR LIMIT=NONE] -->
    <string name="status_item_battery_summary" tools:ignore="MissingTranslation">Akkustand, Ladevorgang und Energiesparmodus</string>
    <!-- Status readout settings: title of the Wi-Fi item. [CHAR LIMIT=40] -->
    <string name="status_item_wifi" tools:ignore="MissingTranslation">WLAN</string>
    <!-- Status readout settings: summary of the Wi-Fi item. [CHAR LIMIT=NONE] -->
    <string name="status_item_wifi_summary" tools:ignore="MissingTranslation">Netzwerkname und Signalstärke</string>
    <!-- Status readout settings: title of the mobile network item. [CHAR LIMIT=40] -->
    <string name="status_item_mobile" tools:ignore="MissingTranslation">Mobilfunknetz</string>
    <!-- Status readout settings: summary of the mobile network item. [CHAR LIMIT=NONE] -->
    <string name="status_item_mobile_summary" tools:ignore="MissingTranslation">Anbieter, Netzwerktyp und Signalstärke</string>
    <!-- Status readout settings: title of the ringer item. [CHAR LIMIT=40] -->
    <string name="status_item_ringer" tools:ignore="MissingTranslation">Klingelton und „Nicht stören“</string>
    <!-- Status readout settings: summary of the ringer item. [CHAR LIMIT=NONE] -->
    <string name="status_item_ringer_summary" tools:ignore="MissingTranslation">Nur, wenn der Klingelton nicht auf Klingeln eingestellt oder „Nicht stören“ aktiviert ist</string>
    <!-- Status readout settings: title of the airplane mode item. [CHAR LIMIT=40] -->
    <string name="status_item_airplane_mode" tools:ignore="MissingTranslation">Flugmodus</string>
    <!-- Status readout settings: summary of the airplane mode item. [CHAR LIMIT=NONE] -->
    <string name="status_item_airplane_mode_summary" tools:ignore="MissingTranslation">Nur, wenn der Flugmodus aktiviert ist</string>
</resources>
