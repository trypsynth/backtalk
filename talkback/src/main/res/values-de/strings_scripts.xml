    <!-- Warns that an import replaces a script by someone else. [CHAR LIMIT=NONE] -->
    <string name="script_update_other_author">Die neue Version stammt von <xliff:g id="author">%1$s</xliff:g>, einem anderen Autor. Aktualisiere nur, wenn du ihr vertraust.</string>
