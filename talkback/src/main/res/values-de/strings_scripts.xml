    <string name="script_import_failed">Import fehlgeschlagen. <xliff:g id="reason">%1$s</xliff:g></string>
    <!-- Marks a permission that gives a script a lot of access. [CHAR LIMIT=NONE] -->
    <string name="script_permission_sensitive"><xliff:g id="permission">%1$s</xliff:g>. Nur für vertrauenswürdige Scripts zulassen.</string>

