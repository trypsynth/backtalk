    <!-- Warning for a script that needs a newer build of Backtalk. [CHAR LIMIT=NONE] -->
    <string name="script_needs_build">Benötigt Backtalk-Build <xliff:g id="needed" example="400">%1$d</xliff:g> oder neuer. Dies ist Build <xliff:g id="current" example="393">%2$d</xliff:g>, daher funktionieren einige Teile möglicherweise nicht.</string>
