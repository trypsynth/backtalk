    <string name="script_update_title"><xliff:g id="name">%1$s</xliff:g> auf <xliff:g id="version">%2$s</xliff:g> aktualisieren?</string>
    <!-- In the update dialog, before the new permissions. [CHAR LIMIT=NONE] -->
    <string name="script_update_new_permissions">Neue Berechtigungen:</string>
