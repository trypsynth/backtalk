<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Title of the setting that checks GitHub for a newer development build of Backtalk. [CHAR LIMIT=40] -->
    <string name="title_pref_check_for_updates">Check for updates</string>
    <!-- Summary of the check for updates setting, with the build number of the running app. [CHAR LIMIT=NONE] -->
    <string name="summary_pref_check_for_updates">Build <xliff:g id="build" example="96">%1$d</xliff:g></string>
    <!-- Title of the switch that turns daily update checks on or off. [CHAR LIMIT=40] -->
    <string name="title_pref_auto_update_check">Automatically check for updates</string>
    <!-- Summary of the automatic update check switch. [CHAR LIMIT=NONE] -->
    <string name="summary_pref_auto_update_check">Check once a day and show a notification when a new build is available</string>

    <!-- Title of the notification that says a new build is available. [CHAR LIMIT=NONE] -->
    <string name="update_notification_title">Backtalk update available</string>
    <!-- Text of the update notification when it has no list of changes. [CHAR LIMIT=NONE] -->
    <string name="update_notification_text">Build <xliff:g id="build" example="97">%1$d</xliff:g>. Tap to install.</string>
    <!-- Title of the dialog that offers to install a new build. [CHAR LIMIT=NONE] -->
    <string name="update_dialog_title">Backtalk build <xliff:g id="build" example="97">%1$d</xliff:g> is available</string>
    <!-- Button in the update dialog that downloads and installs the new build. [CHAR LIMIT=20] -->
    <string name="update_dialog_install">Install</string>

    <!-- Toast shown when a manual update check starts. [CHAR LIMIT=NONE] -->
    <string name="update_checking">Checking for updates</string>
    <!-- Toast shown when a manual update check finds no newer build. [CHAR LIMIT=NONE] -->
    <string name="update_up_to_date">Backtalk is up to date</string>
    <!-- Toast shown when an update check fails. [CHAR LIMIT=NONE] -->
    <string name="update_check_failed">Could not check for updates</string>
    <!-- Title of the update progress dialog and download notification channel. [CHAR LIMIT=NONE] -->
    <string name="update_downloading">Downloading update</string>
    <!-- Update download status while connecting to the server. [CHAR LIMIT=NONE] -->
    <string name="update_connecting">Connecting</string>
    <!-- Update status while checking the APK and preparing its installation. [CHAR LIMIT=NONE] -->
    <string name="update_preparing">Preparing installation</string>
    <!-- Update status after handing the APK to Android for installation. [CHAR LIMIT=NONE] -->
    <string name="update_installing">Installing update</string>
    <!-- Update notification inviting the user back to the system install prompt. [CHAR LIMIT=NONE] -->
    <string name="update_confirm_install">Ready to install. Open to confirm.</string>
    <!-- Update progress dialog status after Android reports success. [CHAR LIMIT=NONE] -->
    <string name="update_installed">Update installed</string>
    <!-- Update progress dialog status after a transfer or preparation failure. [CHAR LIMIT=NONE] -->
    <string name="update_download_failed">Could not download or prepare the update. Check your connection and available storage, then try again.</string>
    <!-- Update status after Android interrupted the download or its foreground time expired. [CHAR LIMIT=NONE] -->
    <string name="update_download_interrupted">The update was interrupted. Try again to restart the download.</string>
    <!-- Button in the update progress dialog to retry a failed or canceled download. [CHAR LIMIT=20] -->
    <string name="update_retry">Retry</string>
    <!-- Download progress: percentage, downloaded file size, total file size. [CHAR LIMIT=NONE] -->
    <string name="update_download_progress"><xliff:g id="percent" example="50">%1$d</xliff:g>%%, <xliff:g id="downloaded" example="25 MB">%2$s</xliff:g> of <xliff:g id="total" example="50 MB">%3$s</xliff:g></string>
    <!-- Toast shown when the update cannot be downloaded or installed. [CHAR LIMIT=NONE] -->
    <string name="update_install_failed">Could not install the update</string>
    <!-- Toast shown on a watch when the update cannot be downloaded over Wi-Fi, for example because the Wi-Fi connection dropped. [CHAR LIMIT=NONE] -->
    <string name="update_wifi_download_failed">Could not download the update over Wi-Fi</string>
    <!-- Toast shown when the user cancels the install. [CHAR LIMIT=NONE] -->
    <string name="update_install_canceled">Update canceled</string>
    <!-- Toast shown with the settings screen where the user allows Backtalk to install apps. [CHAR LIMIT=NONE] -->
    <string name="update_allow_install">Allow Backtalk to install apps, then try the update again</string>
</resources>
